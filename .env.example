# Claude / Anthropic
ANTHROPIC_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google (Calendar + Gmail) — créalo en console.cloud.google.com → APIs & Services → Credentials
# Tipo: "Web application". Authorized redirect URI debe ser EXACTAMENTE igual a GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google-callback

# Midas (app de finanzas) — Midas corre en Lovable Cloud, que nunca expone
# su service role key. En su lugar, Midas tiene su propio endpoint público
# (/api/public/jordan) autenticado con una clave compartida, igual que Synaris.
MIDAS_API_URL=
MIDAS_API_KEY=

# Ascend (app de hábitos/salud) — service role key del proyecto Supabase
# DE ASCEND + el user_id de Felipe dentro de Ascend.
ASCEND_SUPABASE_URL=
ASCEND_SUPABASE_SERVICE_ROLE_KEY=
ASCEND_USER_ID=

# Synaris (interfaz de cara a clientes) — URL pública del proyecto de
# Synaris + la ingest key del cliente (negocio) de Felipe ahí.
SYNARIS_API_URL=
SYNARIS_INGEST_KEY=
